{
  "extends": "@stream-io/typescript-config/library.json",
  "compilerOptions": {
    "rootDir": "./src",
    "paths": {
      "@stream-io/state-store": [
        "./node_modules/@stream-io/state-store",
        "../node_modules/@stream-io/state-store"
      ],
      "@stream-io/state-store/*": [
        "./node_modules/@stream-io/state-store/*",
        "../node_modules/@stream-io/state-store/*"
      ]
    }
  },
  "include": ["./src/**/*"],
  "exclude": [
    "./src/components/docs/*",
    "./src/emoji-data/*.js",
    "./src/mock-builders",
    "./src/styleguideComponents",
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "**/__tests__",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
