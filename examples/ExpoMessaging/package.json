{
  "name": "ExpoMessaging",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "sync-native": "bash ../../package/scripts/reconcile-shared-native.sh expo-package && bash ../../package/scripts/sync-shared-native.sh expo-package",
    "start": "yarn sync-native && expo start --dev-client",
    "android": "yarn sync-native && expo run:android",
    "ios": "yarn sync-native && expo run:ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@op-engineering/op-sqlite": "^18.2.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@shopify/flash-list": "^2.3.3",
    "expo": "^58.0.8",
    "expo-asset": "~58.0.14",
    "expo-audio": "patch:expo-audio@npm%3A58.0.9#~/.yarn/patches/expo-audio-npm-58.0.9-5c313f7a3f.patch",
    "expo-build-properties": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.11",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-haptics": "~58.0.6",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.12",
    "expo-location": "~58.0.14",
    "expo-media-library": "~58.0.8",
    "expo-router": "~58.0.18",
    "expo-sharing": "~58.0.17",
    "expo-splash-screen": "~58.0.8",
    "expo-status-bar": "~58.0.3",
    "expo-video": "~58.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.29.0",
    "react-native-svg": "15.15.5",
    "react-native-teleport": "^1.2.2",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "stream-chat": "^9.54.0",
    "stream-chat-expo": "workspace:^",
    "stream-chat-react-native-core": "workspace:^"
  },
  "devDependencies": {
    "@rnx-kit/metro-config": "^2.1.2",
    "@rnx-kit/metro-resolver-symlinks": "^0.2.6",
    "@stream-io/typescript-config": "workspace:^",
    "@types/react": "~19.3.0",
    "typescript": "6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list",
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@notifee/react-native",
          "expo-modules-jsi"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
