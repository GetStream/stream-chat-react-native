{
  "extends": ["expo/tsconfig.base", "@stream-io/typescript-config/base.json"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      // `nmHoistingLimits: workspaces` gives this workspace and the SDK workspace separate copies of
      // React Native. Without this, the SDK's declarations resolve React Native relative to
      // themselves, so `ColorValue` from the SDK's theme and `ColorValue` in this app's `ViewStyle`
      // can end up as two different nominal types. Pinning the whole program to this workspace's
      // copy models what a real consumer sees (exactly one react-native). The target is the types
      // entry because React Native only exposes it through `exports`, which `paths` bypasses.
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"],
      "react-native/*": ["./node_modules/react-native/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
