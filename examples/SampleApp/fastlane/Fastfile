platform :android do
  lane :firebase_build_and_upload do |options|
    variant = resolve_variant.call(options)
    deploy = options.fetch(:deploy, false)

    UI.message("Deploying to Firebase: #{deploy}")

    if deploy && variant[:firebase_app_id].to_s.empty?
      UI.user_error!('No Firebase app id available. The default variant reads ANDROID_FIREBASE_APP_ID.')
    end

    # Clean
    gradle(
        task: "clean",
        project_dir: "./android"
    )

    # Build the AAB
    gradle(
        task: "assemble",
        build_type: "Release",
        project_dir: "./android",
        properties: variant[:gradle_properties]
    )

    Dir.chdir('..') do
        sh("mkdir -p #{build_output_directory} && mv -f #{lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]} #{apk_path}")
    end

    if deploy
      # Upload to Firebase App Distribution
      firebase_app_distribution(
          app: variant[:firebase_app_id],
          service_credentials_json_data: ENV.fetch('FIREBASE_CREDENTIALS_JSON', nil),
          android_artifact_path: apk_path,
          android_artifact_type: "APK",
          groups: "stream-testers",
          release_notes: build_release_notes.call
      )
    else
      UI.message("Skipping Firebase upload! (deploy: #{deploy})")
    end
  end
end

