skip_docs

# Common Configuration
github_repo = ENV['GITHUB_REPOSITORY'] || 'GetStream/stream-chat-react-native'
root_path = File.absolute_path('../../../')
sdk_size_ext = 'KB'
@force_check = false
build_output_directory = "./app-build"

# iOS Platform Configuration
xcode_project = 'ios/SampleApp.xcodeproj'
xcode_workspace = 'ios/SampleApp.xcworkspace'
output_ipa_name = "reactnativesampleapp.ipa"
info_plist_path = 'SampleApp/Info.plist' # resolved relative to the xcodeproj's directory

# Android Platform Configuration
output_apk_name = "reactnativesampleapp.apk"
apk_path = "#{build_output_directory}/#{output_apk_name}"

# App variants
#
# `default` is the app that ships from develop. `rc` is a permanently named second app used as the
# pre-release channel, so the App Store Connect and Firebase setup is done once and reused for
# every future pre-release branch (V10, V11, ...) rather than recreated per major. Which branch
# owns the channel is decided by the RC_BRANCH repository variable, not by this file.
#
# The iOS and Android identifiers deliberately differ in case, each following the convention its
# own platform's existing identifier already uses. Do not "fix" them into matching: the Android
# value has to equal a `package_name` registered in google-services.json exactly, or the Google
# Services Gradle plugin fails the build with "No matching client found for package name".
VARIANTS = {
  'default' => {
    bundle_id: 'io.getstream.reactnative.SampleApp',
    display_name: 'ChatSample',
    firebase_app_id: ENV.fetch('ANDROID_FIREBASE_APP_ID', nil),
    gradle_properties: {}
  },
  'rc' => {
    bundle_id: 'io.getstream.reactnative.SampleApp.RC',
    display_name: 'ChatSample RC',
    # Hardcoded rather than read from a secret. A Firebase app id is not sensitive (it ships
    # inside the committed google-services.json), and a literal here cannot silently drift out of
    # sync with the Firebase project the way a secret can.
    firebase_app_id: '1:674907137625:android:81f0a13a8223bdbbd7f348',
    gradle_properties: { 'streamRc' => 'true' }
  }
}.freeze

resolve_variant = lambda do |options|
  key = (options[:variant] || 'default').to_s
  unless VARIANTS.key?(key)
    UI.user_error!("Unknown variant '#{key}'. Expected one of: #{VARIANTS.keys.join(', ')}")
  end
  UI.message("Building variant: #{key}")
  VARIANTS[key]
end

# Testers cannot tell RC builds apart by icon or name, so the branch and commit have to travel
# with the build itself.
build_release_notes = lambda do
  commit = Actions.last_git_commit_dict || {}
  branch = ENV['GITHUB_REF_NAME'] || Actions.git_branch || 'unknown branch'
  sha = (ENV['GITHUB_SHA'] || commit[:commit_hash]).to_s[0, 8]
  subject = commit[:message].to_s.lines.first.to_s.strip
  ["#{branch} @ #{sha}", '', subject].join("\n")
end


before_all do
  if is_ci
    setup_ci
    setup_git_config
  end
end

#######################
###### iOS lanes ######
#######################

platform :ios do
  private_lane :missing_appstore_build_error? do |options|
    message = options[:message].to_s

    message.include?('Could not find a live-version') ||
      message.include?('Could not find a beta-version') ||
      message.include?('Could not find a build')
  end

  private_lane :latest_appstore_version_code do |options|
    bundle_id = options[:app_identifier]
    livestates = [true, false]
    version_codes = []
    livestates.each do |livestate|
      vc = app_store_build_number(
        api_key: appstore_api_key,
        live: livestate,
        app_identifier: bundle_id
      )
    rescue StandardError => e
      if missing_appstore_build_error?(message: e.message)
        UI.message(
          "No App Store Connect build found for liveState: #{livestate} bundle_id: #{bundle_id}",
        )
      else
        UI.user_error!(
          "app_store_build_number failed for liveState: #{livestate} bundle_id: #{bundle_id}. #{e.message}",
        )
      end
    else
      version_codes.append(vc)
    end
    version_codes.compact.max
  end

  lane :deploy_to_testflight_qa do |options|
    variant = resolve_variant.call(options)
    bundle_id = variant[:bundle_id]

    match_me(app_identifier: bundle_id)

    deploy = options.fetch(:deploy, false)

    UI.message("Deploying to Testflight: #{deploy}")

    # Point the project at this variant's identity before archiving. This cannot be done through
    # `xcargs`: the project reads PRODUCT_BUNDLE_IDENTIFIER, and overriding that on the xcodebuild
    # command line would apply to every target in the build, CocoaPods resource bundles included.
    update_app_identifier(
      xcodeproj: xcode_project,
      plist_path: info_plist_path,
      app_identifier: bundle_id
    )
    update_info_plist(
      xcodeproj: xcode_project,
      plist_path: info_plist_path,
      display_name: variant[:display_name]
    )

    if deploy
      increment_version_number(
        version_number: load_json(json_path: './package.json')['version'],
        xcodeproj: xcode_project
      )

      current_build_number = latest_appstore_version_code(app_identifier: bundle_id) || get_build_number(
        xcodeproj: xcode_project,
      ).to_i

      puts("Current build number: #{current_build_number}")

      increment_build_number(
        build_number: current_build_number + 1,
        xcodeproj: xcode_project
      )
    end

    settings_to_override = {
      PROVISIONING_PROFILE_SPECIFIER: "match AppStore #{bundle_id}"
    }

    gym(
      workspace: xcode_workspace,
      scheme: 'SampleApp',
      export_method: 'app-store',
      # Built inline rather than read from a plist so the profile mapping follows the variant's
      # bundle id. The values mirror the export options plist this replaced.
      export_options: {
        iCloudContainerEnvironment: 'Development',
        provisioningProfiles: { bundle_id => "match AppStore #{bundle_id}" }
      },
      silent: true,
      clean: true,
      xcargs: settings_to_override,
      include_symbols: true,
      output_directory: build_output_directory,
      output_name: File.basename(output_ipa_name, '.ipa')
    )

    if deploy
      upload_to_testflight(
        api_key: appstore_api_key,
        groups: ['Testers'],
        changelog: build_release_notes.call,
        reject_build_waiting_for_review: true,
        ipa: "#{build_output_directory}/#{output_ipa_name}",
        skip_waiting_for_build_processing: true
      )
    else
      UI.message("Skipping Testflight upload! (deploy: #{deploy})")
    end
  end

  private_lane :appstore_api_key do
    @appstore_api_key ||= app_store_connect_api_key(
      key_id: 'MT3PRT8TB7',
      issuer_id: '69a6de96-0738-47e3-e053-5b8c7c11a4d1',
      key_content: ENV.fetch('APPSTORE_API_KEY', nil),
      in_house: false
    )
  end

  desc "If `readonly: true` (by default), installs all Certs and Profiles necessary for development and ad-hoc.\nIf `readonly: false`, recreates all Profiles necessary for development and ad-hoc, updates them locally and remotely.\nPass `app_identifier:` (or `variant:rc`) to target the RC channel's bundle id."
  lane :match_me do |options|
    app_identifier = options[:app_identifier] || resolve_variant.call(options)[:bundle_id]

    custom_match(
      api_key: appstore_api_key,
      app_identifier: [app_identifier],
      readonly: options[:readonly],
      register_device: options[:register_device]
    )
  end
end

###########################
###### Android lanes ######
###########################

platform :android do
  lane :firebase_build_and_upload do |options|
    variant = resolve_variant.call(options)
    deploy = options.fetch(:deploy, false)

    UI.message("Deploying to Firebase: #{deploy}")

    if deploy && variant[:firebase_app_id].to_s.empty?
      UI.user_error!('No Firebase app id available. The default variant reads ANDROID_FIREBASE_APP_ID.')
    end

    # Clean
    gradle(
        task: "clean",
        project_dir: "./android"
    )

    # Build the AAB
    gradle(
        task: "assemble",
        build_type: "Release",
        project_dir: "./android",
        properties: variant[:gradle_properties]
    )

    Dir.chdir('..') do
        sh("mkdir -p #{build_output_directory} && mv -f #{lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]} #{apk_path}")
    end

    if deploy
      # Upload to Firebase App Distribution
      firebase_app_distribution(
          app: variant[:firebase_app_id],
          service_credentials_json_data: ENV.fetch('FIREBASE_CREDENTIALS_JSON', nil),
          android_artifact_path: apk_path,
          android_artifact_type: "APK",
          groups: "stream-testers",
          release_notes: build_release_notes.call
      )
    else
      UI.message("Skipping Firebase upload! (deploy: #{deploy})")
    end
  end
end

##########################
###### Common lanes ######
##########################

lane :file_size do |options|
  File.size(options[:path]) / 1024.0
end

lane :yarn_all do
  Dir.chdir(root_path) { sh('yarn --frozen-lockfile') }
  Dir.chdir("#{root_path}/package") { sh('yarn --frozen-lockfile') }
  Dir.chdir("#{root_path}/package/native-package") { sh('yarn') }
  Dir.chdir("#{root_path}/package/expo-package") { sh('yarn') }
end

lane :frameworks_sizes do
  Dir.chdir(root_path) do
    yarn_all
    sh('yarn build')
    sh('yarn minify-bundle')

    js_bundle_size = file_size(path: 'package/lib/module/bundle.min.js')
    { js_bundle_size: js_bundle_size }
  end
end

lane :show_frameworks_sizes do |options|
  next unless is_check_required(sources: ['package/'], force_check: @force_check)

  sizes = options[:sizes] || frameworks_sizes
  show_sdk_size(branch_sizes: sizes, github_repo: github_repo, size_ext: sdk_size_ext)
  update_img_shields_sdk_sizes(sizes: sizes, open_pr: options[:open_pr]) if options[:update_readme]
end

lane :update_img_shields_sdk_sizes do |options|
  update_sdk_size_in_readme(
    readme_path: '../../README.md',
    open_pr: options[:open_pr] || false,
    pr_title: 'chore: update sdk size',
    sizes: options[:sizes] || frameworks_sizes,
    size_ext: sdk_size_ext
  )
end
