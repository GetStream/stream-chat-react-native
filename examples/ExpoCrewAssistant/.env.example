# Copy to .env.local (gitignored) and fill in. Public values only: Expo inlines every EXPO_PUBLIC_
# variable into the app bundle. The Stream secret stays with the crew backend.

# The Stream app the Vision-Agents router runs in.
EXPO_PUBLIC_STREAM_API_KEY=YOUR_STREAM_API_KEY

# The router and the crew backend (crew_assistant's `go run ./backend`). On an Android emulator,
# `adb reverse tcp:8080 tcp:8080 && adb reverse tcp:8097 tcp:8097` makes localhost reach them.
EXPO_PUBLIC_AGENT_ROUTER_URL=http://localhost:8080
EXPO_PUBLIC_CREW_BACKEND_URL=http://localhost:8097

# The customer and agent `go run ./configure` stored, and who this app is.
EXPO_PUBLIC_AGENT_CUSTOMER_ID=examples
EXPO_PUBLIC_AGENT_NAME=crew_assistant
EXPO_PUBLIC_AGENT_USER_ID=crew-jordan

# Who the team lead view signs in as. The crew backend keeps each person's crew role in their Stream
# user's custom data, and only a leader reads the leaders' inbox.
EXPO_PUBLIC_AGENT_LEADER_ID=crew-maya
