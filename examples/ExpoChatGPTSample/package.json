    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.2",
