{
  "extends": ["expo/tsconfig.base", "@stream-io/typescript-config/base.json"],
  "compilerOptions": {
    "paths": {
      // Same as ExpoMessaging: pins the whole program to this workspace's copy of React Native.
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"],
      "react-native/*": ["./node_modules/react-native/*"],
      // The same for the state stores: AgentChat's and the SDK's are then one class to TypeScript.
      "@stream-io/state-store": ["./node_modules/@stream-io/state-store"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
